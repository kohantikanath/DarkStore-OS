VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Set to "true" to run entirely without a backend: MSW answers every REST
# call, BroadcastChannel stands in for the WebSocket (works across tabs in
# the same browser). VITE_API_URL/VITE_WS_URL above are ignored when this
# is on — MSW intercepts fetch() regardless of the URL it was called with.
VITE_USE_MOCK=false
